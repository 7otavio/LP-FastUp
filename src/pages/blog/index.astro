---
import ContentLayout from '@/layouts/ContentLayout.astro';
import Breadcrumb from '@/components/site/Breadcrumb.astro';
import { CATEGORIES } from '@/config/site';
import { breadcrumbLd, formatDate, getPosts, postUrl } from '@/lib/content';

const posts = await getPosts();
const grupos = CATEGORIES.map((cat) => ({ cat, posts: posts.filter((p) => p.data.category === cat.slug) })).filter((g) => g.posts.length > 0);
const jsonLd = [breadcrumbLd([{ name: 'Início', path: '/' }, { name: 'Blog', path: '/blog/' }])];
---

<ContentLayout
  title="Blog da Fast Up | Marketing imobiliário na prática"
  description="Conteúdos práticos sobre tráfego pago, vídeo de imóvel, atendimento de leads e gestão comercial para imobiliárias, corretores e incorporadoras."
  jsonLd={jsonLd}
>
  <div class="mx-auto max-w-5xl container-px pb-20 pt-10 sm:pt-14">
    <Breadcrumb items={[{ label: 'Início', href: '/' }, { label: 'Blog' }]} />
    <header class="mt-8 max-w-3xl">
      <p class="text-xs font-semibold uppercase tracking-[0.22em] text-brand-400">Blog</p>
      <h1 class="mt-4 font-display text-4xl font-extrabold leading-tight text-white sm:text-5xl">Marketing imobiliário na prática</h1>
      <p class="mt-5 text-lg leading-relaxed text-ink-200">
        Guias para quem vende imóveis: como anunciar, como gerar contatos, como gravar vídeos que funcionam e como organizar a equipe para não perder venda.
      </p>
    </header>

    {grupos.map(({ cat, posts }) => (
      <section aria-labelledby={`cat-${cat.slug}`} class="mt-16">
        <h2 id={`cat-${cat.slug}`} class="font-display text-2xl font-bold text-white sm:text-3xl">{cat.nome}</h2>
        <p class="mt-2 text-ink-300">{cat.descricao}</p>
        <ul class="mt-6 grid gap-4 sm:grid-cols-2">
          {posts.map((post) => (
            <li>
              <a href={postUrl(post.id)} class="flex h-full flex-col rounded-2xl border border-white/10 bg-white/[0.03] p-6 transition-colors hover:border-brand-500/50">
                <span class="font-display text-lg font-semibold leading-snug text-white">{post.data.title}</span>
                <span class="mt-3 text-sm leading-relaxed text-ink-300">{post.data.description}</span>
                <span class="mt-4 text-xs text-ink-400">{formatDate(post.data.pubDate)}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</ContentLayout>
