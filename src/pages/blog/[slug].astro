---
import { render } from 'astro:content';
import ContentLayout from '@/layouts/ContentLayout.astro';
import Breadcrumb from '@/components/site/Breadcrumb.astro';
import FaqList from '@/components/site/FaqList.astro';
import CtaBox from '@/components/site/CtaBox.astro';
import { categoria } from '@/config/site';
import { ORGANIZATION, absolute, breadcrumbLd, faqLd, formatDate, getPosts, getSolucoes, postUrl, readingTime, solucaoUrl, type Post } from '@/lib/content';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

type Props = { post: Post };
const { post } = Astro.props;
const { data } = post;
const { Content, headings } = await render(post);
const cat = categoria(data.category)!;
const toc = headings.filter((heading) => heading.depth === 2);

const posts = await getPosts();
const outros = posts.filter((p) => p.id !== post.id);
const leiaTambem = [...outros.filter((p) => p.data.category === data.category), ...outros.filter((p) => p.data.category !== data.category)].slice(0, 3);
const solucoes = (await getSolucoes()).filter((s) => s.data.relacionados.some((r) => r.id === post.id)).slice(0, 4);

const CTA: Record<string, { titulo: string; texto: string; mensagem: string; link: { href: string; label: string } }> = {
  'trafego-pago': {
    titulo: 'Quer campanhas que gerem contatos de verdade?',
    texto: 'A Fast Up estrutura e acompanha campanhas no Meta Ads para imobiliárias, corretores e incorporadoras, com os contatos chegando direto no WhatsApp.',
    mensagem: 'Olá! Li um conteúdo do blog sobre tráfego pago e quero entender como a Fast Up pode ajudar.',
    link: { href: '/#servicos', label: 'Conhecer os serviços' },
  },
  'video-imobiliario': {
    titulo: 'Precisa de vídeos dos seus imóveis?',
    texto: 'A Fast Up cuida do roteiro, da captação e da edição. Se preferir gravar você mesmo, o curso Corretor de Autoridade ensina o passo a passo com o celular.',
    mensagem: 'Olá! Li um conteúdo do blog sobre vídeo de imóvel e quero saber mais sobre a produção de vídeos da Fast Up.',
    link: { href: '/#curso', label: 'Conhecer o curso' },
  },
  'leads-e-atendimento': {
    titulo: 'Quer mais contatos qualificados no WhatsApp?',
    texto: 'Vídeo bem feito e anúncio bem direcionado são o começo. A Fast Up ajuda você a montar essa estrutura para vender mais imóveis.',
    mensagem: 'Olá! Li um conteúdo do blog sobre anúncios e leads e quero conversar com a Fast Up.',
    link: { href: '/#servicos', label: 'Conhecer os serviços' },
  },
  'gestao-comercial': {
    titulo: 'Quer encher o topo do seu funil?',
    texto: 'A Fast Up gera contatos com vídeo e tráfego pago para a sua equipe trabalhar. O curso Corretor de Autoridade ajuda cada corretor a fazer a parte dele no digital.',
    mensagem: 'Olá! Li um conteúdo do blog sobre gestão comercial e quero conversar com a Fast Up.',
    link: { href: '/#curso', label: 'Conhecer o curso' },
  },
};
const cta = CTA[data.category];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: data.title,
    description: data.description,
    datePublished: data.pubDate.toISOString(),
    dateModified: (data.updatedDate ?? data.pubDate).toISOString(),
    inLanguage: 'pt-BR',
    keywords: data.keywords.join(', '),
    mainEntityOfPage: absolute(postUrl(post.id)),
    image: absolute('/assets/brand-original-3.png'),
    author: ORGANIZATION,
    publisher: ORGANIZATION,
  },
  faqLd(data.faq),
  breadcrumbLd([
    { name: 'Início', path: '/' },
    { name: 'Blog', path: '/blog/' },
    { name: data.title, path: postUrl(post.id) },
  ]),
];
---

<ContentLayout title={`${data.title} | Fast Up`} description={data.description} ogType="article" jsonLd={jsonLd}>
  <article class="mx-auto max-w-3xl container-px pb-20 pt-10 sm:pt-14">
    <Breadcrumb items={[{ label: 'Início', href: '/' }, { label: 'Blog', href: '/blog/' }, { label: cat.nome }]} />

    <header class="mt-8">
      <p class="text-xs font-semibold uppercase tracking-[0.22em] text-brand-400">{cat.nome}</p>
      <h1 class="mt-4 font-display text-3xl font-extrabold leading-tight text-white sm:text-4xl lg:text-5xl">{data.title}</h1>
      <p class="mt-5 text-lg leading-relaxed text-ink-200">{data.description}</p>
      <p class="mt-5 text-sm text-ink-400">
        <time datetime={data.pubDate.toISOString()}>{formatDate(data.pubDate)}</time>
        {data.updatedDate && <> · atualizado em <time datetime={data.updatedDate.toISOString()}>{formatDate(data.updatedDate)}</time></>}
        {' · '}{readingTime(post.body)} min de leitura
      </p>
    </header>

    {toc.length > 2 && (
      <nav aria-label="Sumário" class="mt-10 rounded-2xl border border-white/10 bg-white/[0.03] p-5 sm:p-6">
        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-ink-400">Neste artigo</p>
        <ol class="mt-3 space-y-2 text-sm">
          {toc.map((heading) => (
            <li><a href={`#${heading.slug}`} class="text-ink-200 transition-colors hover:text-brand-300">{heading.text}</a></li>
          ))}
        </ol>
      </nav>
    )}

    <div class="prose prose-invert prose-lg mt-10 max-w-none prose-headings:font-display prose-headings:text-white prose-h2:mt-14 prose-h2:scroll-mt-28 prose-h3:scroll-mt-28 prose-p:text-ink-200 prose-li:text-ink-200 prose-li:marker:text-brand-400 prose-a:text-brand-300 prose-a:underline-offset-4 hover:prose-a:text-brand-200 prose-strong:text-white prose-th:text-white prose-td:text-ink-200 prose-hr:border-white/10">
      <Content />
    </div>

    <FaqList items={data.faq} />

    {cta && <CtaBox {...cta} />}

    {solucoes.length > 0 && (
      <section aria-labelledby="solucoes-relacionadas" class="mt-16">
        <h2 id="solucoes-relacionadas" class="font-display text-2xl font-bold text-white">Soluções relacionadas</h2>
        <ul class="mt-6 grid gap-3 sm:grid-cols-2">
          {solucoes.map((s) => (
            <li>
              <a href={solucaoUrl(s.id)} class="block h-full rounded-2xl border border-white/10 bg-white/[0.03] p-5 transition-colors hover:border-brand-500/50">
                <span class="font-semibold text-white">{s.data.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {leiaTambem.length > 0 && (
      <section aria-labelledby="leia-tambem" class="mt-16">
        <h2 id="leia-tambem" class="font-display text-2xl font-bold text-white">Leia também</h2>
        <ul class="mt-6 grid gap-3">
          {leiaTambem.map((p) => (
            <li>
              <a href={postUrl(p.id)} class="block rounded-2xl border border-white/10 bg-white/[0.03] p-5 transition-colors hover:border-brand-500/50">
                <span class="text-xs font-semibold uppercase tracking-[0.18em] text-brand-400">{categoria(p.data.category)?.nome}</span>
                <span class="mt-2 block font-semibold text-white">{p.data.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </article>
</ContentLayout>
