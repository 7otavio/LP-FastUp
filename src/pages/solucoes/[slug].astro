---
import { getEntries, render } from 'astro:content';
import ContentLayout from '@/layouts/ContentLayout.astro';
import Breadcrumb from '@/components/site/Breadcrumb.astro';
import FaqList from '@/components/site/FaqList.astro';
import CtaBox from '@/components/site/CtaBox.astro';
import { categoria, publico, servico } from '@/config/site';
import { whatsappLink } from '@/contact';
import { ORGANIZATION, absolute, breadcrumbLd, faqLd, getSolucoes, postUrl, solucaoUrl, type Solucao } from '@/lib/content';

export async function getStaticPaths() {
  const solucoes = await getSolucoes();
  return solucoes.map((solucao) => ({ params: { slug: solucao.id }, props: { solucao } }));
}

type Props = { solucao: Solucao };
const { solucao } = Astro.props;
const { data } = solucao;
const { Content } = await render(solucao);
const serv = servico(data.servico)!;
const pub = publico(data.publico)!;
const relacionados = await getEntries(data.relacionados);
const outras = (await getSolucoes()).filter((s) => s.id !== solucao.id && s.data.servico === data.servico).slice(0, 4);
const mensagem = `Olá! Vi a página "${data.title}" no site da Fast Up e quero conversar.`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: data.title,
    description: data.description,
    serviceType: serv.nome,
    audience: { '@type': 'Audience', audienceType: pub.nome },
    provider: ORGANIZATION,
    url: absolute(solucaoUrl(solucao.id)),
  },
  faqLd(data.faq),
  breadcrumbLd([
    { name: 'Início', path: '/' },
    { name: 'Soluções', path: '/solucoes/' },
    { name: data.title, path: solucaoUrl(solucao.id) },
  ]),
];
---

<ContentLayout title={`${data.title} | Fast Up`} description={data.description} jsonLd={jsonLd}>
  <article class="mx-auto max-w-4xl container-px pb-20 pt-10 sm:pt-14">
    <Breadcrumb items={[{ label: 'Início', href: '/' }, { label: 'Soluções', href: '/solucoes/' }, { label: data.title }]} />

    <header class="mt-8">
      <p class="text-xs font-semibold uppercase tracking-[0.22em] text-brand-400">{serv.nome} · {pub.nome}</p>
      <h1 class="mt-4 font-display text-3xl font-extrabold leading-tight text-white sm:text-4xl lg:text-5xl">{data.title}</h1>
      <p class="mt-5 max-w-3xl text-lg leading-relaxed text-ink-200">{data.resumo}</p>
      <a href={whatsappLink(mensagem)} target="_blank" rel="noreferrer noopener" class="mt-8 inline-flex items-center gap-2 rounded-full bg-brand-500 px-6 py-3 text-sm font-semibold text-ink-900 shadow-glow transition-all hover:bg-brand-400">
        Conversar sobre o meu caso
      </a>
    </header>

    <section aria-labelledby="desafios" class="mt-16">
      <h2 id="desafios" class="font-display text-2xl font-bold text-white sm:text-3xl">Os desafios de quem trabalha com {data.nicho}</h2>
      <ul class="mt-6 grid gap-4 sm:grid-cols-2">
        {data.dores.map((dor) => (
          <li class="rounded-2xl border border-white/10 bg-white/[0.03] p-5 sm:p-6">
            <h3 class="font-display text-lg font-semibold text-white">{dor.titulo}</h3>
            <p class="mt-2 leading-relaxed text-ink-200">{dor.texto}</p>
          </li>
        ))}
      </ul>
    </section>

    <div class="prose prose-invert prose-lg mt-16 max-w-none prose-headings:font-display prose-headings:text-white prose-h2:scroll-mt-28 prose-p:text-ink-200 prose-li:text-ink-200 prose-li:marker:text-brand-400 prose-a:text-brand-300 prose-a:underline-offset-4 hover:prose-a:text-brand-200 prose-strong:text-white">
      <Content />
    </div>

    <section aria-labelledby="como-trabalhamos" class="mt-16">
      <h2 id="como-trabalhamos" class="font-display text-2xl font-bold text-white sm:text-3xl">Como a Fast Up trabalha</h2>
      <ol class="mt-6 space-y-4">
        {data.processo.map((etapa, index) => (
          <li class="flex gap-4 rounded-2xl border border-white/10 bg-white/[0.03] p-5 sm:p-6">
            <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-brand-500/15 font-display text-sm font-bold text-brand-300">{index + 1}</span>
            <div>
              <h3 class="font-display text-lg font-semibold text-white">{etapa.titulo}</h3>
              <p class="mt-1.5 leading-relaxed text-ink-200">{etapa.texto}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section aria-labelledby="entregas" class="mt-16">
      <h2 id="entregas" class="font-display text-2xl font-bold text-white sm:text-3xl">O que você recebe</h2>
      <ul class="mt-6 grid gap-3 sm:grid-cols-2">
        {data.entregas.map((item) => (
          <li class="flex gap-3 rounded-xl border border-white/10 bg-white/[0.03] p-4 text-ink-100">
            <span aria-hidden="true" class="text-brand-400">✓</span><span>{item}</span>
          </li>
        ))}
      </ul>
    </section>

    <FaqList items={data.faq} />

    <section aria-labelledby="para-ler" class="mt-16">
      <h2 id="para-ler" class="font-display text-2xl font-bold text-white">Conteúdos para aprofundar</h2>
      <ul class="mt-6 grid gap-3">
        {relacionados.map((p) => (
          <li>
            <a href={postUrl(p.id)} class="block rounded-2xl border border-white/10 bg-white/[0.03] p-5 transition-colors hover:border-brand-500/50">
              <span class="text-xs font-semibold uppercase tracking-[0.18em] text-brand-400">{categoria(p.data.category)?.nome}</span>
              <span class="mt-2 block font-semibold text-white">{p.data.title}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <CtaBox
      titulo="Vamos falar sobre o seu projeto?"
      texto={`Conte para a gente como é a sua operação com ${data.nicho}. A conversa é pelo WhatsApp, sem compromisso.`}
      mensagem={mensagem}
      link={{ href: '/solucoes/', label: 'Ver outras soluções' }}
    />

    {outras.length > 0 && (
      <section aria-labelledby="outras" class="mt-16">
        <h2 id="outras" class="font-display text-2xl font-bold text-white">Outras soluções de {serv.nome.toLowerCase()}</h2>
        <ul class="mt-6 grid gap-3 sm:grid-cols-2">
          {outras.map((s) => (
            <li>
              <a href={solucaoUrl(s.id)} class="block h-full rounded-2xl border border-white/10 bg-white/[0.03] p-5 transition-colors hover:border-brand-500/50">
                <span class="font-semibold text-white">{s.data.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </article>
</ContentLayout>
