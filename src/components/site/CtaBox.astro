---
import { whatsappLink } from '@/contact';

type Props = {
  titulo: string;
  texto: string;
  mensagem: string;
  link?: { href: string; label: string };
};
const { titulo, texto, mensagem, link } = Astro.props;
---

<aside class="mt-16 overflow-hidden rounded-3xl border border-brand-500/30 bg-gradient-to-br from-brand-500/15 via-ink-800 to-ink-900 p-6 sm:p-10">
  <p class="font-display text-2xl font-bold text-white sm:text-3xl">{titulo}</p>
  <p class="mt-3 max-w-2xl leading-relaxed text-ink-200">{texto}</p>
  <div class="mt-6 flex flex-wrap gap-3">
    <a href={whatsappLink(mensagem)} target="_blank" rel="noreferrer noopener" class="inline-flex items-center gap-2 rounded-full bg-brand-500 px-6 py-3 text-sm font-semibold text-ink-900 shadow-glow transition-all hover:bg-brand-400">
      Falar no WhatsApp
    </a>
    {link && (
      <a href={link.href} class="inline-flex items-center gap-2 rounded-full border border-white/15 px-6 py-3 text-sm font-semibold text-white transition-colors hover:border-brand-500/60 hover:text-brand-300">
        {link.label}
      </a>
    )}
  </div>
</aside>
