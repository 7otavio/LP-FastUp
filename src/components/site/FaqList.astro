---
type Props = {
  items: { pergunta: string; resposta: string }[];
  titulo?: string;
};
const { items, titulo = 'Perguntas frequentes' } = Astro.props;
---

<section aria-labelledby="faq" class="mt-16">
  <h2 id="faq" class="font-display text-2xl font-bold text-white sm:text-3xl">{titulo}</h2>
  <div class="mt-6 divide-y divide-white/10 rounded-2xl border border-white/10 bg-white/[0.03]">
    {items.map((item) => (
      <details class="group px-5 py-4 sm:px-6">
        <summary class="flex cursor-pointer list-none items-start justify-between gap-4 font-medium text-white [&::-webkit-details-marker]:hidden">
          <span>{item.pergunta}</span>
          <span aria-hidden="true" class="mt-0.5 text-brand-400 transition-transform group-open:rotate-45">+</span>
        </summary>
        <p class="mt-3 leading-relaxed text-ink-200">{item.resposta}</p>
      </details>
    ))}
  </div>
</section>
