---
type Item = { label: string; href?: string };
type Props = { items: Item[] };
const { items } = Astro.props;
---

<nav aria-label="Você está em" class="text-sm text-ink-400">
  <ol class="flex flex-wrap items-center gap-x-2 gap-y-1">
    {items.map((item, index) => (
      <li class="flex items-center gap-2">
        {index > 0 && <span aria-hidden="true" class="text-ink-500">/</span>}
        {item.href ? (
          <a href={item.href} class="transition-colors hover:text-brand-300">{item.label}</a>
        ) : (
          <span aria-current="page" class="text-ink-200">{item.label}</span>
        )}
      </li>
    ))}
  </ol>
</nav>
